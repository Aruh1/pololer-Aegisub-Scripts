{
    "dependencyControlFeedFormatVersion": "0.3.0",
    "name": "pololer's Aegisub Scripts",
    "description": "Kumpulan automation scripts untuk Aegisub, terinspirasi dari fitur-fitur Subtitle Edit.",
    "maintainer": "pololer",
    "baseUrl": "https://github.com/Aruh1/pololer-Aegisub-Scripts",
    "url": "@{baseUrl}",
    "fileBaseUrl": "https://raw.githubusercontent.com/Aruh1/pololer-Aegisub-Scripts/main",
    "macros": {
        "polo.FrameGap": {
            "fileBaseUrl": "@{fileBaseUrl}/macros/@{namespace}",
            "url": "@{baseUrl}#@{namespace}",
            "author": "pololer",
            "name": "Frame Gap",
            "description": "Apply/Remove gaps between subtitles like Subtitle Edit",
            "channels": {
                "main": {
                    "default": true,
                    "version": "1.2.0",
                    "released": "2026-01-24",
                    "files": [
                        {
                            "name": ".lua",
                            "url": "@{fileBaseUrl}@{fileName}",
                            "sha1": "7bdd983828aa4cb0b73124d310fa6394cd058c0b"
                        }
                    ]
                }
            },
            "changelog": {
                "1.0.0": [
                    "Initial release with Frame Gap feature"
                ],
                "1.1.0": [
                    "Add De-Frame Gap feature",
                    "Fix time calculation bug (ms vs cs)",
                    "Fix frame rate dropdown"
                ],
                "1.2.0": [
                    "Performance optimization: lazy loading selection set, pre-calculated dialogue count",
                    "Bug fix: Add missing `return sel` to all macro functions",
                    "Bug fix: Early exit for files with < 2 dialogue lines",
                    "Refactor: Remove unused import (`aegisub.util`)",
                    "Refactor: Replace `goto continue` with cleaner control flow",
                    "Add constants: `MIN_SUBTITLE_DURATION_MS` and `DEFAULT_MAX_GAP_TO_CLOSE`",
                    "Add LuaDoc annotations for main functions"
                ]
            }
        },
        "polo.KaraSplitter": {
            "fileBaseUrl": "@{fileBaseUrl}/macros/@{namespace}",
            "url": "@{baseUrl}#@{namespace}",
            "author": "pololer",
            "name": "KaraSplitter",
            "description": "Split karaoke timing by character, word, or syllable",
            "channels": {
                "main": {
                    "default": true,
                    "version": "1.1.0",
                    "released": "2026-02-18",
                    "files": [
                        {
                            "name": ".lua",
                            "url": "@{fileBaseUrl}@{fileName}",
                            "sha1": "87fed3484d842a8749988850ef72b9c7eba9c748"
                        }
                    ]
                }
            },
            "changelog": {
                "1.1.0": [
                    "Bug fix: Preserve non-karaoke override tags during splitting",
                    "Only strip karaoke timing tags (\\k, \\K, \\kf, \\ko)"
                ],
                "1.0.0": [
                    "Initial release",
                    "Split modes: character, word, syllable (Japanese romaji)",
                    "K-timing options: calculated or fixed {\\k1}",
                    "De-Ktime: Remove all karaoke timing tags",
                    "Full UTF-8 support"
                ]
            }
        }
    }
}